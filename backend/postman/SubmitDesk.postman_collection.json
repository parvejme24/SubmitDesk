{
  "info": {
    "name": "SubmitDesk API",
    "description": "Project Review Dashboard API. Run 'Login (student)' or 'Login (mentor)' first: the token is saved to {{token}} and sent as a Bearer header. The API also sets an httpOnly cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (student)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"test.student@example.com\",\n  \"password\": \"Password1\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (student)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@example.com\",\n  \"password\": \"Student@12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (mentor)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mentor@example.com\",\n  \"password\": \"Mentor@12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Submissions (student)",
      "item": [
        {
          "name": "Create submission",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Weather Dashboard\",\n  \"repoUrl\": \"https://github.com/your-name/weather-dashboard\",\n  \"liveUrl\": \"https://weather-dashboard.vercel.app\",\n  \"description\": \"A weather dashboard built with React, showing a 5-day forecast and search by city.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('submissionId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate (expect 409)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Weather Dashboard\",\n  \"repoUrl\": \"https://www.GitHub.com/your-name/weather-dashboard.git/\",\n  \"liveUrl\": \"https://weather-dashboard.vercel.app\",\n  \"description\": \"A weather dashboard built with React, showing a 5-day forecast and search by city.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "My submissions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/submissions/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "me"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Resubmit rejected",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/submissions/{{submissionId}}/resubmit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "{{submissionId}}",
                "resubmit"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Weather Dashboard\",\n  \"repoUrl\": \"https://github.com/your-name/weather-dashboard\",\n  \"liveUrl\": \"https://weather-dashboard.vercel.app\",\n  \"description\": \"A weather dashboard built with React, showing a 5-day forecast and search by city. Fixed mobile layout.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Mentor",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mentor/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mentor",
                "stats"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "List submissions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mentor/submissions?page=1&limit=10&status=PENDING&sort=newest&search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mentor",
                "submissions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "sort",
                  "value": "newest"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/mentor/submissions/{{submissionId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mentor",
                "submissions",
                "{{submissionId}}",
                "review"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"comment\": \"Great work!\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Reject",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/mentor/submissions/{{submissionId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mentor",
                "submissions",
                "{{submissionId}}",
                "review"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECTED\",\n  \"comment\": \"README is missing setup steps.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}