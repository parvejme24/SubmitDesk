generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions         Submission[] @relation("StudentSubmissions")
  reviewedSubmissions Submission[] @relation("ReviewedSubmissions")
  feedbacks           Feedback[]

  @@map("users")
}

model Submission {
  id          String           @id @default(cuid())
  projectName String
  repoUrl     String // as typed by the student (for display)
  repoUrlKey  String           @unique // normalized → duplicate guard
  liveUrl     String
  description String
  status      SubmissionStatus @default(PENDING)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  feedbacks Feedback[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt]) // mentor table: filter by status, sort by date
  @@index([studentId]) // student "my submissions"
  @@map("submissions")
}

model Feedback {
  id           String           @id @default(cuid())
  comment      String?
  decision     SubmissionStatus // APPROVED or REJECTED at that moment
  mark         Int? // 0–100 (DB check constraint). Null only on reviews made before marks existed
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       User             @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([submissionId])
  @@map("feedbacks")
}
